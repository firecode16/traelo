{
  "expo": {
    "name": "traelo",
    "slug": "traelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_traelo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_traelo.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Permiso requerido para acceder a la cámara.",
        "NSPhotoLibraryUsageDescription": "Permiso requerido para acceder a la galería de fotos.",
        "NSLocationWhenInUseUsageDescription": "Permiso requerido para acceder a tu ubicación mientras usas la app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_icon_traelo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "com.traelo.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC9j2y_FhfBmmBOqMNF5oJ6EHrD5myc0wE"
        }
      },
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permiso requerido para acceder a la galería de fotos."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "98633fed-0a64-4bc4-89f2-ef270179d18b"
      }
    },
    "owner": "hfredi35"
  }
}
