{
  "expo": {
    "name": "Traelo App",
    "slug": "traelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_traelo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_traelo.png",
      "resizeMode": "contain",
      "backgroundColor": "#00CC86"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Permiso requerido para acceder a la cámara.",
        "NSPhotoLibraryUsageDescription": "Permiso requerido para acceder a la galería de fotos.",
        "NSLocationWhenInUseUsageDescription": "Permiso requerido para acceder a tu ubicación mientras usas la app."
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#00CC86"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "com.company.app",
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permiso requerido para acceder a la galería de fotos."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsAccessToken": "MAPBOX_ACCESS_TOKEN"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "PROJECT_ID"
      }
    }
  }
}
